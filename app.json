{
  "expo": {
    "name": "SkillInnoveX",
    "slug": "skillinnovex-app",
    "description": "Create resumes, portfolios, cover letters, ATS reviews, and polished writing with SkillInnoveX.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./APP_Icons/ic_launcher-web.png",
    "scheme": "skillinnovexapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.skillinnovex.app",
      "supportsTablet": true
    },
    "android": {
      "package": "in.skillinnovex.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./APP_Icons/ic_launcher-web.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./APP_Icons/ic_launcher-web.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkillInnoveX to choose profile and signature images for your documents."
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df43f142-8120-4318-9e51-38577c66dc6f"
      }
    }
  }
}
